<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" width="512" height="512" viewBox="0 0 512 512" xmlns:c2pa="http://c2pa.org/manifest"><metadata><c2pa:manifest></c2pa:manifest></metadata>
  <title>Horizon Disk Utility</title>
  <defs>
    <linearGradient id="casing" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#f1f4f8"/>
      <stop offset="0.55" stop-color="#cfd6e1"/>
      <stop offset="1" stop-color="#9ba7ba"/>
    </linearGradient>
    <linearGradient id="cavity" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#2c3444"/>
      <stop offset="1" stop-color="#171c27"/>
    </linearGradient>
    <radialGradient id="platter" cx="0.42" cy="0.38" r="0.75">
      <stop offset="0" stop-color="#f7f9fc"/>
      <stop offset="0.6" stop-color="#cbd3e0"/>
      <stop offset="1" stop-color="#8f9cb2"/>
    </radialGradient>
    <linearGradient id="hub" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#b6c0d0"/>
      <stop offset="1" stop-color="#58637a"/>
    </linearGradient>
    <linearGradient id="cap" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#f1f4f9"/>
      <stop offset="1" stop-color="#8a97ad"/>
    </linearGradient>
    <linearGradient id="arm" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#465168"/>
      <stop offset="1" stop-color="#2a3243"/>
    </linearGradient>
    <linearGradient id="coil" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#55617a"/>
      <stop offset="1" stop-color="#363f53"/>
    </linearGradient>
    <linearGradient id="slider" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#e3e8f0"/>
      <stop offset="1" stop-color="#a5b0c3"/>
    </linearGradient>
    <linearGradient id="sheen" gradientUnits="userSpaceOnUse" x1="224" y1="256" x2="224" y2="106">
      <stop offset="0" stop-color="#ffffff" stop-opacity="0.15"/>
      <stop offset="1" stop-color="#ffffff" stop-opacity="0.65"/>
    </linearGradient>
    <radialGradient id="led" cx="0.5" cy="0.5" r="0.5">
      <stop offset="0" stop-color="#8cc2ff"/>
      <stop offset="1" stop-color="#2f6ff0"/>
    </radialGradient>
    <clipPath id="platterClip">
      <circle cx="224" cy="256" r="150"/>
    </clipPath>
    <filter id="bodyShadow" x="-10%" y="-10%" width="120%" height="125%">
      <feGaussianBlur stdDeviation="10"/>
    </filter>
    <filter id="soft" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="5"/>
    </filter>
    <filter id="platterShadow" x="-20%" y="-20%" width="140%" height="145%">
      <feDropShadow dx="0" dy="8" stdDeviation="8" flood-color="#02050a" flood-opacity="0.6"/>
    </filter>
    <filter id="armShadow" x="-30%" y="-30%" width="160%" height="160%">
      <feDropShadow dx="3" dy="6" stdDeviation="4" flood-color="#0b0f17" flood-opacity="0.5"/>
    </filter>
    <filter id="ledGlow" x="-200%" y="-200%" width="500%" height="500%">
      <feGaussianBlur stdDeviation="4"/>
    </filter>
  </defs>

  <!-- Casing -->
  <rect x="32" y="58" width="448" height="416" rx="44" fill="#000000" opacity="0.38" filter="url(#bodyShadow)"/>
  <rect x="32" y="48" width="448" height="416" rx="44" fill="url(#casing)"/>
  <rect x="33" y="49" width="446" height="414" rx="43" fill="none" stroke="#ffffff" stroke-opacity="0.75" stroke-width="2"/>
  <rect x="32" y="48" width="448" height="416" rx="44" fill="none" stroke="#6b778d" stroke-opacity="0.55" stroke-width="1.5"/>

  <!-- Corner mounting screws -->
  <g>
    <circle cx="51" cy="67" r="7" fill="#7f8ba0"/>
    <circle cx="51" cy="67" r="5" fill="#3b4558"/>
    <circle cx="461" cy="67" r="7" fill="#7f8ba0"/>
    <circle cx="461" cy="67" r="5" fill="#3b4558"/>
    <circle cx="51" cy="445" r="7" fill="#7f8ba0"/>
    <circle cx="51" cy="445" r="5" fill="#3b4558"/>
    <circle cx="461" cy="445" r="7" fill="#7f8ba0"/>
    <circle cx="461" cy="445" r="5" fill="#3b4558"/>
  </g>

  <!-- Drive cavity -->
  <rect x="56" y="73" width="400" height="368" rx="22" fill="#ffffff" opacity="0.7" transform="translate(0 1.5)"/>
  <rect x="56" y="72" width="400" height="368" rx="22" fill="url(#cavity)"/>
  <rect x="56" y="72" width="400" height="368" rx="22" fill="none" stroke="#06090f" stroke-opacity="0.6" stroke-width="2"/>

  <!-- Platter -->
  <g filter="url(#platterShadow)">
    <circle cx="224" cy="256" r="150" fill="url(#platter)"/>
  </g>
  <circle cx="224" cy="256" r="150" fill="none" stroke="#5f6c82" stroke-width="2"/>
  <circle cx="224" cy="256" r="147" fill="none" stroke="#ffffff" stroke-opacity="0.55" stroke-width="1.5"/>
  <circle cx="224" cy="256" r="132" fill="none" stroke="#5f6c82" stroke-opacity="0.25" stroke-width="1.5"/>
  <g fill="none" stroke="#ffffff" stroke-opacity="0.28" stroke-width="1.5">
    <circle cx="224" cy="256" r="120"/>
    <circle cx="224" cy="256" r="108"/>
    <circle cx="224" cy="256" r="96"/>
    <circle cx="224" cy="256" r="84"/>
  </g>
  <g fill="none" stroke="#5f6c82" stroke-opacity="0.14" stroke-width="1.5">
    <circle cx="224" cy="256" r="121.5"/>
    <circle cx="224" cy="256" r="109.5"/>
    <circle cx="224" cy="256" r="97.5"/>
    <circle cx="224" cy="256" r="85.5"/>
  </g>
  <circle cx="224" cy="256" r="66" fill="none" stroke="#5f6c82" stroke-opacity="0.3" stroke-width="1.5"/>

  <!-- Platter reflections -->
  <g clip-path="url(#platterClip)">
    <g filter="url(#soft)" fill="url(#sheen)" opacity="0.7">
      <path d="M224,256 L318,79 L401,162 Z"/>
      <path d="M224,256 L130,433 L47,350 Z"/>
    </g>
  </g>

  <!-- Spindle hub -->
  <circle cx="224" cy="256" r="44" fill="url(#hub)"/>
  <circle cx="224" cy="256" r="44" fill="none" stroke="#ffffff" stroke-opacity="0.45" stroke-width="1.5"/>
  <circle cx="224" cy="256" r="44" fill="none" stroke="#2f3748" stroke-opacity="0.5" stroke-width="1" transform="translate(0 0.5)"/>
  <g fill="#2c3445">
    <circle cx="224" cy="227" r="4"/>
    <circle cx="249.1" cy="241.5" r="4"/>
    <circle cx="249.1" cy="270.5" r="4"/>
    <circle cx="224" cy="285" r="4"/>
    <circle cx="198.9" cy="270.5" r="4"/>
    <circle cx="198.9" cy="241.5" r="4"/>
  </g>
  <circle cx="224" cy="256" r="16" fill="url(#cap)"/>
  <circle cx="224" cy="256" r="16" fill="none" stroke="#5a667c" stroke-opacity="0.7" stroke-width="1.5"/>

  <!-- Actuator arm -->
  <g transform="translate(386 330) rotate(204.5)">
    <g filter="url(#armShadow)">
      <path d="M-4,-15 L-46,-31 Q-54,-33 -54,-24 L-54,24 Q-54,33 -46,31 L-4,15 Z" fill="url(#coil)"/>
      <path fill-rule="evenodd" fill="url(#arm)"
            d="M0,-15 L92,-5.5 L96,-4 L96,4 L92,5.5 L0,15 Z
               M30,-3.5 H66 A3.5,3.5 0 0 1 66,3.5 H30 A3.5,3.5 0 0 1 30,-3.5 Z"/>
      <path d="M92,-6 H105 A3,3 0 0 1 108,-3 V3 A3,3 0 0 1 105,6 H92 Z" fill="url(#slider)"/>
    </g>
    <g fill="none" stroke="#ffffff" stroke-opacity="0.12" stroke-width="1.5">
      <path d="M-14,-17 L-14,17"/>
      <path d="M-24,-20 L-24,20"/>
      <path d="M-34,-23 L-34,23"/>
      <path d="M-44,-26 L-44,26"/>
    </g>
    <circle cx="0" cy="0" r="27" fill="#232a38"/>
    <circle cx="0" cy="0" r="27" fill="none" stroke="#ffffff" stroke-opacity="0.18" stroke-width="1.5"/>
    <circle cx="0" cy="0" r="18" fill="url(#hub)"/>
    <circle cx="0" cy="0" r="7" fill="#2c3445"/>
  </g>

  <!-- Activity LED -->
  <circle cx="424" cy="452" r="6" fill="#2f6ff0" opacity="0.8" filter="url(#ledGlow)"/>
  <circle cx="424" cy="452" r="5" fill="url(#led)"/>
  <circle cx="424" cy="452" r="5" fill="none" stroke="#ffffff" stroke-opacity="0.5" stroke-width="1"/>
</svg>
