  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "{{ colors.on_surface_variant.default.hex }}", "fontStyle": "italic" }
    },
    {
      "scope": ["string", "string.quoted", "string.regexp", "string.template"],
      "settings": { "foreground": "{{ colors.tertiary.default.hex }}" }
    },
    {
      "scope": ["constant.numeric", "constant.language", "constant.character"],
      "settings": { "foreground": "{{ colors.primary_fixed_dim.default.hex }}" }
    },
    {
      "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control"],
      "settings": { "foreground": "{{ colors.primary.default.hex }}" }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"],
      "settings": { "foreground": "{{ colors.primary_fixed.default.hex }}" }
    },
    {
      "scope": ["entity.name.function", "support.function", "entity.name.tag"],
      "settings": { "foreground": "{{ colors.primary_container.default.hex }}" }
    },
    {
      "scope": ["variable", "variable.other", "variable.parameter"],
      "settings": { "foreground": "{{ colors.on_surface.default.hex }}" }
    },
    {
      "scope": ["variable.language", "variable.parameter.function"],
      "settings": { "foreground": "{{ colors.secondary.default.hex }}" }
    },
    {
      "scope": ["variable.other.constant", "variable.other.property"],
      "settings": { "foreground": "{{ colors.secondary_fixed.default.hex }}" }
    },
    {
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "{{ colors.tertiary_container.default.hex }}" }
    },
    {
      "scope": ["punctuation", "operator", "keyword.operator"],
      "settings": { "foreground": "{{ colors.on_surface_variant.default.hex }}" }
    },
    {
      "scope": ["meta.embedded", "entity.name.section"],
      "settings": { "foreground": "{{ colors.inverse_primary.default.hex }}" }
    },
    {
      "scope": ["invalid.illegal", "invalid.deprecated"],
      "settings": { "foreground": "{{ colors.error.default.hex }}" }
    }
  ]
}